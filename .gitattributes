# Fins de ligne normalisées en LF (standard Linux / CI)
* text=auto eol=lf

# Scripts Windows : doivent rester en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires : jamais modifiés par Git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary