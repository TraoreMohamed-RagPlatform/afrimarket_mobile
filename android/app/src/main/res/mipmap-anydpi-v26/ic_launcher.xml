<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative AfriMarket (ADR 0011) : fond crème, chariot au premier
     plan (zone sûre), version monochrome pour les icônes à thème (Android 13).
     Les environnements dev et staging remplacent le premier plan (pastille). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
